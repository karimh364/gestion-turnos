# Copiar como .env y completar con los valores de la instalación local.
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=gestion_turnos
DB_PORT=3306

# Completar con una clave privada propia; no publicar el archivo .env.
JWT_SECRET=
FRONTEND_URL=http://localhost:3000

# Credenciales elegidas localmente para crear el administrador inicial.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Sin SMTP_HOST se utiliza Ethereal y se muestra la vista previa en la terminal.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
